# La placa Sense trae 8MB de flash y 8MB de PSRAM octal integrados.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Tabla de particiones propia -- ESP-SR necesita una partición
# llamada "model" para guardar los modelos de wake word (ver
# partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wake word "Jarvis" (WakeNet9).
CONFIG_SR_WN_WN9_JARVIS_TTS=y
